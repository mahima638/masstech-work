@model Fincore.Domain.Entity.RFQ

@{
    ViewData["Title"] = "Bid Items";
}

<div class="container mt-4">

    <h2 class="mb-4">Add RFQ</h2>


    <div class="row text-center mb-4">

        <div class="col-md-4">
            <div class="rounded-circle bg-success text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                ✓
            </div>
            <span>RFQ BID DETAILS</span>
        </div>

        <div class="col-md-4">
            <div class="rounded-circle bg-primary text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                2
            </div>
            <strong>BID ITEMS</strong>
        </div>

        <div class="col-md-4">
            <div class="rounded-circle bg-secondary text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                3
            </div>
            <span>DURATION AND VENDORS</span>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="card-body">

               
                <div class="mb-4">
                    <label class="form-label">RFQ No</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.RFQNo"
                           readonly />
                </div>

                <h5 class="text-primary mb-4">
                    BID ITEMS
                </h5>

        

            <form asp-action="AddItem" method="post">

                <input type="hidden"
                       name="RFQId"
                       value="@Model.RFQId" />

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Indent No</label>
                        <input name="IndentNo"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Line No</label>
                        <input name="RFQLineNo"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Item No</label>
                        <input name="ItemNo"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Item Name</label>
                        <input name="ItemName"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Required Quantity
                        </label>

                        <input name="ReqQty"
                               type="number"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">UOM</label>

                        <input name="UOM"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Delivery Date
                        </label>

                        <input name="ReqDeliveryDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Delivery Location
                        </label>

                        <input name="DeliveryLocation"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Factory Code
                        </label>

                        <input name="FactoryCode"
                               class="form-control" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">
                            Description
                        </label>

                        <textarea name="Description"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                </div>

                <div class="text-end">

                    <button type="submit"
                            class="btn btn-primary">
                        Add Item
                    </button>

                </div>

            </form>

            <hr class="my-4" />


            <h6>Added Items</h6>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>
                        <tr>
                            <th>Line No</th>
                            <th>Item No</th>
                            <th>Item Name</th>
                            <th>Qty</th>
                            <th>UOM</th>
                            <th>Delivery Date</th>
                            <th>Location</th>
                            <th>Factory</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.Items)
                        {
                            <tr>
                                <td>@item.RFQLineNo</td>
                                <td>@item.ItemNo</td>
                                <td>@item.ItemName</td>
                                <td>@item.ReqQty</td>
                                <td>@item.UOM</td>
                                <td>
                                    @item.ReqDeliveryDate.ToString("dd-MM-yyyy")
                                </td>
                                <td>@item.DeliveryLocation</td>
                                <td>@item.FactoryCode</td>
                                <td>@item.Description</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-between mt-3">

                <a asp-action="Create"
                   class="btn btn-secondary">
                    Previous
                </a>

                <a asp-action="Duration"
                   asp-route-id="@Model.RFQId"
                   class="btn btn-primary">
                    Next
                </a>

            </div>

        </div>

    </div>

</div>
@model List<Fincore.Domain.Entity.RFQ>

@{
    ViewData["Title"] = "RFQ List";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>RFQ List</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Add RFQ
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>RFQ No</th>
                        <th>Contact Person</th>
                        <th>Mobile</th>
                        <th>Bid Start</th>
                        <th>Bid End</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var rfq in Model)
                    {
                        <tr>

                            <td>
                                @rfq.RFQNo
                            </td>

                            <td>
                                @rfq.ContactPerson
                            </td>

                            <td>
                                @rfq.Mobile
                            </td>

                            <td>
                                @rfq.BidDate?.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @rfq.ExpiryDateofBid?.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @if (rfq.Status == "Published")
                                {
                                    <span class="badge bg-success">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-action="Items"
                                   asp-route-id="@rfq.RFQId"
                                   class="btn btn-sm btn-info">
                                    View
                                </a>
                                <a asp-action="Quotations"
                                   asp-route-id="@rfq.RFQId"
                                   class="btn btn-sm btn-success">
                                    Quotations
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
@model Fincore.Domain.Entity.RFQ

@{
    ViewData["Title"] = "Add RFQ";
}

<div class="container mt-4">

    <h2 class="mb-4">Add RFQ</h2>

    
    <div class="row text-center mb-4">

        <div class="col-md-4">
            <div class="rounded-circle bg-primary text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                1
            </div>
            <strong>RFQ BID DETAILS</strong>
        </div>

        <div class="col-md-4">
            <div class="rounded-circle bg-secondary text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                2
            </div>
            <span>BID ITEMS</span>
        </div>

        <div class="col-md-4">
            <div class="rounded-circle bg-secondary text-white mx-auto mb-2"
                 style="width:40px;height:40px;padding-top:8px;">
                3
            </div>
            <span>DURATION AND VENDORS</span>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="text-primary mb-4">
                RFQ BID DETAILS
            </h5>

            <form asp-action="Create" method="post">

                <div class="row">

                    <!-- RFQ Number -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">RFQ No</label>

                        <input asp-for="RFQNo"
                               class="form-control"
                               
                               readonly />
                    </div>

                    <!-- Mobile -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Mobile"
                               class="form-label">
                            Mobile No
                        </label>

                        <input asp-for="Mobile"
                               class="form-control" />
                    </div>

                    <!-- Contact Person -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactPerson"
                               class="form-label">
                            Contact Person
                        </label>

                        <input asp-for="ContactPerson"
                               class="form-control" />
                    </div>

                </div>

                <div class="text-end mt-3">

                    <button type="submit"
                            name="action"
                            value="draft"
                            class="btn btn-secondary">
                        Save Draft
                    </button>

                    <button type="submit"
                            name="action"
                            value="next"
                            class="btn btn-primary">
                        Next
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
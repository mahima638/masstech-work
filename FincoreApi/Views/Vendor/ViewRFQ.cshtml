@model Fincore.Domain.Entity.RFQ

@{
    ViewData["Title"] = "RFQ Details";
}

<div class="container mt-4">

    <h2 class="mb-4">RFQ Details</h2>

    <div class="card mb-4">

        <div class="card-header bg-primary text-white">
            RFQ Details
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <strong>RFQ No</strong>
                    <p>@Model.RFQNo</p>
                </div>

                <div class="col-md-4">
                    <strong>Contact Person</strong>
                    <p>@Model.ContactPerson</p>
                </div>

                <div class="col-md-4">
                    <strong>Mobile</strong>
                    <p>@Model.Mobile</p>
                </div>

                <div class="col-md-4">
                    <strong>Bid Start</strong>
                    <p>@Model.BidDate?.ToString("dd-MM-yyyy")</p>
                </div>

                <div class="col-md-4">
                    <strong>Bid End</strong>
                    <p>@Model.ExpiryDateofBid?.ToString("dd-MM-yyyy")</p>
                </div>

            </div>

        </div>

    </div>

    <div class="card">

        <div class="card-header bg-primary text-white">
            RFQ Items
        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Indent No</th>
                        <th>Line No</th>
                        <th>Item No</th>
                        <th>Item Name</th>
                        <th>Quantity</th>
                        <th>UOM</th>
                        <th>Delivery Date</th>
                        <th>Location</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in ViewBag.Items)
                    {
                        <tr>
                            <td>@item.IndentNo</td>
                            <td>@item.RFQLineNo</td>
                            <td>@item.ItemNo</td>
                            <td>@item.ItemName</td>
                            <td>@item.ReqQty</td>
                            <td>@item.UOM</td>
                            <td>@item.ReqDeliveryDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.DeliveryLocation</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="mt-3">

        <a asp-action="MyRFQs"
           class="btn btn-secondary">
            Back
        </a>

    </div>
    <div class="mt-3 text-end">

        <a asp-action="Quote"
           asp-route-id="@Model.RFQId"
           class="btn btn-success">
            Submit Quotation
        </a>

    </div>

</div>